# ==========================================================================
# Bigcapital — variables de entorno
# Copia a .env y llena los valores. NO commitees el .env real.
#   cp .env.example .env
# ==========================================================================

# --- App -------------------------------------------------------------------
# URL pública (debe coincidir con el dominio que asignes en Coolify)
BASE_URL=https://finance.aaatmi.com
# Genera con: openssl rand -base64 48
APP_JWT_SECRET=

# --- Mail (para invitaciones a socios y envío de facturas) -----------------
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_FROM_NAME=Chatmu Finance
MAIL_FROM_ADDRESS=finance@chatmu.io

# --- Base de datos ---------------------------------------------------------
DB_USER=bigcapital
# Genera con: openssl rand -base64 32  (y actualízalo en mysql-init/10-grant.sql)
DB_PASSWORD=
# Genera con: openssl rand -hex 24
DB_ROOT_PASSWORD=
DB_CHARSET=utf8
SYSTEM_DB_NAME=bigcapital_system
TENANT_DB_NAME_PERFIX=bigcapital_tenant_

# --- Registro de usuarios --------------------------------------------------
# Pon true cuando ya hayas creado tu cuenta y la de tus socios.
SIGNUP_DISABLED=false
SIGNUP_ALLOWED_DOMAINS=
SIGNUP_ALLOWED_EMAILS=
SIGNUP_EMAIL_CONFIRMATION=false

# --- Exchange rates --------------------------------------------------------
EXCHANGE_RATE_SERVICE=open-exchange-rate
# https://openexchangerates.org/ (opcional)
OPEN_EXCHANGE_RATE_APP_ID=

# --- S3 (Cloudflare R2) para adjuntos / PDFs -------------------------------
S3_REGION=auto
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=chatmu-finance
S3_FORCE_PATH_STYLE=true

# --- Stripe (cobrar facturas desde Bigcapital) -----------------------------
STRIPE_PAYMENT_SECRET_KEY=
STRIPE_PAYMENT_PUBLISHABLE_KEY=
STRIPE_PAYMENT_CLIENT_ID=
STRIPE_PAYMENT_WEBHOOKS_SECRET=
STRIPE_PAYMENT_REDIRECT_URL=https://finance.aaatmi.com/preferences/payment-methods/stripe/callback

# --- API throttling --------------------------------------------------------
THROTTLE_GLOBAL_TTL=60000
THROTTLE_GLOBAL_LIMIT=300
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=30
